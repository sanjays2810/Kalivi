<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<%@ taglib prefix="k" tagdir="/WEB-INF/tags" %>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title><c:out value="${pageTitle}"/> | Kalvi Admin</title>
  <link rel="icon" href="${ctx}/images/logo.svg" type="image/svg+xml">
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">
  <link href="${ctx}/css/kalvi.css" rel="stylesheet">
</head>
<body class="admin-body">
<div id="loading" class="loading-overlay"><div class="spinner-border text-primary" role="status"></div></div>
<div class="app-shell">
  <aside class="sidebar no-print" id="sidebar">
    <a class="kalvi-logo text-white mb-3" href="${ctx}/admin/dashboard"><img src="${ctx}/images/logo.svg" width="36" height="36" alt=""><span><strong>KALVI</strong><small>Admin Panel</small></span></a>
    <nav class="nav flex-column">
      <a class="nav-link ${activeAdmin == 'dashboard' ? 'active' : ''}" href="${ctx}/admin/dashboard"><i class="fa-solid fa-gauge"></i>Dashboard</a>
      <a class="nav-link ${activeAdmin == 'students' ? 'active' : ''}" href="${ctx}/admin/students"><i class="fa-solid fa-user-graduate"></i>Students</a>
      <a class="nav-link ${activeAdmin == 'courses' ? 'active' : ''}" href="${ctx}/admin/courses"><i class="fa-solid fa-book"></i>Courses</a>
      <a class="nav-link ${activeAdmin == 'exams' ? 'active' : ''}" href="${ctx}/admin/exams"><i class="fa-solid fa-landmark"></i>Government Exams</a>
      <a class="nav-link ${activeAdmin == 'dates' ? 'active' : ''}" href="${ctx}/admin/exams"><i class="fa-solid fa-calendar-days"></i>Exam Dates &amp; Centers</a>
      <a class="nav-link ${activeAdmin == 'resources' ? 'active' : ''}" href="${ctx}/admin/resources"><i class="fa-solid fa-link"></i>Resources</a>
      <a class="nav-link ${activeAdmin == 'libraries' ? 'active' : ''}" href="${ctx}/admin/libraries"><i class="fa-solid fa-building-columns"></i>Libraries</a>
      <a class="nav-link ${activeAdmin == 'notifications' ? 'active' : ''}" href="${ctx}/admin/notifications"><i class="fa-solid fa-bell"></i>Notifications</a>
      <a class="nav-link ${activeAdmin == 'reports' ? 'active' : ''}" href="${ctx}/admin/reports"><i class="fa-solid fa-chart-pie"></i>Reports</a>
      <a class="nav-link ${activeAdmin == 'settings' ? 'active' : ''}" href="${ctx}/admin/settings"><i class="fa-solid fa-gear"></i>Settings</a>
      <a class="nav-link" href="${ctx}/logout"><i class="fa-solid fa-right-from-bracket"></i>Logout</a>
    </nav>
  </aside>
  <div class="app-main">
    <header class="topbar no-print">
      <button class="btn btn-light d-lg-none" type="button" onclick="document.getElementById('sidebar').classList.toggle('open')" aria-label="Menu"><i class="fa-solid fa-bars"></i></button>
      <h1 class="h5 mb-0"><c:out value="${pageTitle}"/></h1>
      <div class="ms-auto d-flex align-items-center gap-3"><a href="${ctx}/" class="small" target="_blank">View site <i class="fa-solid fa-arrow-up-right-from-square"></i></a>
        <span class="avatar"><c:out value="${fn:substring(sessionScope.user.fullName,0,1)}"/></span></div>
    </header>
    <div class="p-3 p-lg-4">
    <c:if test="${not empty sessionScope.flashMsg}">
      <div class="alert alert-${sessionScope.flashType} alert-dismissible fade show"><c:out value="${sessionScope.flashMsg}"/><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
      <c:remove var="flashMsg" scope="session"/><c:remove var="flashType" scope="session"/>
    </c:if>
    <c:if test="${not empty errors}"><div class="alert alert-danger"><ul class="mb-0"><c:forEach items="${errors}" var="e"><li><c:out value="${e}"/></li></c:forEach></ul></div></c:if>
