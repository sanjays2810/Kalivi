<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<%@ taglib prefix="k" tagdir="/WEB-INF/tags" %>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<c:set var="lang" value="${empty sessionScope.lang ? 'en' : sessionScope.lang}"/>
<fmt:setLocale value="${lang}"/>
<fmt:setBundle basename="messages"/>
<!DOCTYPE html>
<html lang="${lang}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><c:out value="${empty pageTitle ? 'Kalvi' : pageTitle}"/> | Kalvi - Education &bull; Career &bull; Future</title>
  <link rel="icon" href="${ctx}/images/logo.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Noto+Sans+Tamil:wght@400;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">
  <link href="${ctx}/css/kalvi.css" rel="stylesheet">
</head>
<body class="${bodyClass}">
<div id="loading" class="loading-overlay" aria-hidden="true"><div class="spinner-border text-primary" role="status"></div></div>
<a class="visually-hidden-focusable" href="#main">Skip to content</a>
<nav class="navbar navbar-expand-lg kalvi-nav sticky-top no-print">
  <div class="container">
    <a class="navbar-brand kalvi-logo" href="${ctx}/">
      <img src="${ctx}/images/logo.svg" width="38" height="38" alt="">
      <span><strong>KALVI</strong><small>Education &bull; Career &bull; Future</small></span>
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu" aria-controls="navMenu" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
    <div class="collapse navbar-collapse" id="navMenu">
      <ul class="navbar-nav mx-lg-auto mb-2 mb-lg-0">
        <li class="nav-item"><a class="nav-link ${activeNav == 'home' ? 'active' : ''}" href="${ctx}/"><fmt:message key="nav.home"/></a></li>
        <li class="nav-item"><a class="nav-link ${activeNav == 'courses' ? 'active' : ''}" href="${ctx}/courses"><fmt:message key="nav.courses"/></a></li>
        <li class="nav-item"><a class="nav-link ${activeNav == 'exams' ? 'active' : ''}" href="${ctx}/exams"><fmt:message key="nav.exams"/></a></li>
        <li class="nav-item"><a class="nav-link ${activeNav == 'roadmap' ? 'active' : ''}" href="${ctx}/roadmap"><fmt:message key="nav.roadmap"/></a></li>
        <li class="nav-item"><a class="nav-link ${activeNav == 'resources' ? 'active' : ''}" href="${ctx}/resources"><fmt:message key="nav.resources"/></a></li>
        <li class="nav-item"><a class="nav-link ${activeNav == 'about' ? 'active' : ''}" href="${ctx}/about.jsp"><fmt:message key="nav.about"/></a></li>
      </ul>
      <div class="d-flex align-items-center gap-2 flex-wrap">
        <div class="lang-switch" role="group" aria-label="Language">
          <a href="${ctx}/lang?code=en" class="${lang == 'en' ? 'on' : ''}">English</a><a href="${ctx}/lang?code=ta" class="${lang == 'ta' ? 'on' : ''}">தமிழ்</a>
        </div>
        <c:choose>
          <c:when test="${not empty sessionScope.user}">
            <a class="btn btn-sm btn-primary" href="${ctx}/${sessionScope.user.role == 'ADMIN' ? 'admin' : 'student'}/dashboard"><i class="fa-solid fa-gauge me-1"></i><fmt:message key="nav.dashboard"/></a>
            <a class="btn btn-sm btn-outline-secondary" href="${ctx}/logout"><fmt:message key="nav.logout"/></a>
          </c:when>
          <c:otherwise>
            <a class="btn btn-sm btn-outline-primary" href="${ctx}/login"><fmt:message key="nav.login"/></a>
            <a class="btn btn-sm btn-primary" href="${ctx}/register"><fmt:message key="nav.register"/></a>
          </c:otherwise>
        </c:choose>
      </div>
    </div>
  </div>
</nav>
<main id="main">
<c:if test="${not empty sessionScope.flashMsg}">
  <div class="container mt-3 no-print"><div class="alert alert-${sessionScope.flashType} alert-dismissible fade show" role="alert"><c:out value="${sessionScope.flashMsg}"/><button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div></div>
  <c:remove var="flashMsg" scope="session"/><c:remove var="flashType" scope="session"/>
</c:if>
